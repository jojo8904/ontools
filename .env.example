# Optional browser read access. Leave blank to use labelled offline fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: GitHub Actions secrets, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=

# Existing GA4 measurement ID is the default. Disabled in development.
NEXT_PUBLIC_GA_ID=G-JMXBEHHQ4K

# AdSense approval is pending. Configure only real issued IDs.
# Publisher ID may be used to connect the site for review.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_RELATED=

# Optional AdFit override; existing issued ID remains the code default.
NEXT_PUBLIC_ADFIT_UNIT_ID=

# Optional crawler failure notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
